# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/travelspac/travelspace.by"
PassengerBaseURI "/"
PassengerPython "/home/travelspac/virtualenv/travelspace.by/3.13/bin/python"
PassengerAppLogFile "/home/travelspac/logs/passenger-travelspace.log"
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
Options -Indexes

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault A0
    ExpiresByType image/gif A691200
    ExpiresByType image/png A691200
    ExpiresByType image/jpeg A691200
    ExpiresByType image/webp A691200
    ExpiresByType video/mp4 A2592000
    ExpiresByType text/css A691200
    ExpiresByType text/javascript A691200
    ExpiresByType application/javascript A691200
    ExpiresByType font/ttf A691200
    ExpiresByType font/otf A691200
    ExpiresByType font/woff A691200
    ExpiresByType font/woff2 A691200
</IfModule>

<FilesMatch "^(\.env|\.web\.config|php_errors\.log|error_log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
    </IfModule>
</FilesMatch>

ErrorDocument 401 "Unauthorized"
ErrorDocument 403 "Forbidden"

RewriteEngine On

# Do not touch SSL / CloudLinux / Let's Encrypt files.
RewriteRule ^\.well-known/ - [L]

# One HTTPS canonical origin for search engines and visitors. X-Forwarded-Proto
# prevents a redirect loop when TLS is terminated before Apache/Passenger.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://travelspace.by%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTP_HOST} !^travelspace\.by$ [NC]
RewriteRule ^ https://travelspace.by%{REQUEST_URI} [R=301,L,NE]

# React build static files
RewriteRule ^static/(.*)$ public/static/$1 [L]

# Public files from React build root
RewriteRule ^favicon\.ico$ public/favicon.ico [L]
RewriteRule ^manifest\.json$ public/manifest.json [L]
RewriteRule ^asset-manifest\.json$ public/asset-manifest.json [L]
RewriteRule ^background-journey\.mp4$ public/background-journey.mp4 [L]
RewriteRule ^og-image\.jpg$ public/og-image.jpg [L]

# Everything else goes to Passenger / FastAPI

# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END
